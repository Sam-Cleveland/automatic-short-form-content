# Copy to .env and fill in values. .env is gitignored.
# Only the keys for the backends you actually use are required.

# OpenAI — required for: transcribe=whisper_api, story command with api_type=openai
OPENAI_API_KEY=

# Anthropic — required for: story command with api_type=anthropic
ANTHROPIC_API_KEY=

# ElevenLabs — required for: tts=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
